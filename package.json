{
  "name": "starbase430",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A lightweight independent-web project portfolio and mission log for Sam and Brea.",
  "license": "MIT",
  "scripts": {
    "dev": "eleventy --serve",
    "build": "eleventy",
    "update:fse-timeline": "node scripts/update-fse-timeline.js",
    "build:favicons": "node scripts/build-favicons.js",
    "test": "node --test",
    "check:budgets": "node scripts/check-page-budgets.js",
    "check:site": "node scripts/check-site.js",
    "review:pablo-images": "node scripts/review-pablo-images.js",
    "check:a11y": "node scripts/check-accessibility.js",
    "setup:a11y": "PLAYWRIGHT_BROWSERS_PATH=.cache/a11y-browsers playwright install --only-shell chromium",
    "check:all": "npm test && npm run check:release && npm run check:site && npm run check:budgets && npm run check:a11y",
    "check:release": "node scripts/check-release-snapshot.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "@11ty/eleventy-plugin-rss": "3.0.0",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "parse-srcset": "1.0.2",
    "posthtml-parser": "0.11.0",
    "sharp": "0.35.5"
  }
}
