<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% if aeaPage %}<style>{% include "aea-article.css" %}</style>{% endif %}
    <title>{% if page.url == "/" %}{{ site.name }}{% else %}{{ title }} | {{ site.name }}{% endif %}</title>
    <meta name="description" content="{{ description or site.description }}">
    {% if author %}<meta name="author" content="{{ authors[author].name }}">{% endif %}
    <link rel="alternate" type="application/rss+xml" href="{{ feeds.all.url }}" title="{{ feeds.all.title }}">
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32">
    <link rel="icon" href="/assets/icons/favicon.svg" type="image/svg+xml" sizes="any">
    <link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png" sizes="180x180">
    <link rel="stylesheet" href="/assets/css/site.css?v={{ siteCssVersion }}">
{% if polargraph %}    <style>.polargraph-embed{margin:2rem 0;max-inline-size:100%}.polargraph-embed iframe{display:block;inline-size:100%;max-inline-size:100%;border:1px solid var(--line);border-radius:.5rem;background:var(--panel)}.polargraph-embed figcaption{margin-block-start:.75rem;color:var(--muted);font-size:.9em}</style><script type="module" src="/assets/illustrations/pablo/polargraph-frame.js"></script>
{% endif %}  </head>
  <body class="site-body">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    {% include "partials/space-background.njk" %}
    <div class="shell">
      <header class="station">
        <div class="station-identity">
          <a class="brand" href="/">STARBASE<strong>430</strong></a>
          <p class="station-label"><span aria-hidden="true">|</span> INDIEWEB OUTPOST</p>
        </div>
          <nav class="primary-nav" aria-label="Primary">
            <ul>
              {% for item in site.navigation %}
                <li><a href="{{ item.url }}"{% if navKey == item.key %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
              {% endfor %}
            </ul>
          </nav>
      </header>
      {% set reading = content | readingLayout %}
      <div class="layout{% if not reading.chapters.length %} layout--without-chapters{% endif %}">
        {% if reading.chapters.length %}
        <aside class="rail">
          <nav class="chapter-nav" aria-label="{% if author %}Article chapters{% else %}On this page{% endif %}">
            <p class="eyebrow">{% if author %}Chapters{% else %}On this page{% endif %}</p>
            <ul>{% for chapter in reading.chapters %}
              <li><a href="{{ chapter.href | escape }}"><span aria-hidden="true">{{ loop.index }}</span> {{ chapter.title | escape }}</a></li>
            {% endfor %}</ul>
          </nav>
        </aside>
        {% endif %}
        <div class="page-panel">
        <main class="main-content" id="main-content" tabindex="-1">
          <div class="reading-content">{{ reading.html | externalLinks(site.url) | safe }}</div>
        </main>
          <footer class="site-footer endcap" role="contentinfo">
            <p><small>Copyright &copy; 2026 Sam and Brea. <a href="/colophon/">Colophon</a>.</small></p>
            <nav class="feed-nav" aria-label="RSS feed">
              <ul><li><a href="{{ feeds.all.url }}">{{ feeds.all.label }}</a></li></ul>
            </nav>
            <p><small>External links open in a new tab.</small></p>
          </footer>
        </div>
      </div>
      <aside class="credits" aria-label="Background credit">Background: an original CSS nebula and starfield.</aside>
    </div>
  </body>
</html>
